<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <t t-name="hudson_kitchen_display.KitchenOrderStatusCard">
        <div t-if="this.hasDisplays" class="hkd_self_status_box text-start" t-on-click.stop="() => {}">
            <div class="hkd_self_batches_summary">
                <span class="hkd_self_batches_summary_label">
                    <span class="hkd_self_live_dot"/>
                    <t t-if="this.hasMultipleBatches">
                        Live Kitchen Status · <t t-out="this.batches.length"/> stations
                    </t>
                    <t t-else="">Live Kitchen Status</t>
                </span>
                <span class="hkd_self_tap_hint">Tap to view details</span>
            </div>
            <t t-foreach="this.batches" t-as="batch" t-key="batch.ticket_id">
                <t t-set="isExpanded" t-value="this.isBatchExpanded(batch)"/>
                <div t-attf-class="hkd_self_status_station hkd_self_status_station--card #{this.getStationThemeClass(batch)} #{isExpanded ? 'hkd_self_status_station--expanded' : ''}">
                    <div
                        class="hkd_self_status_header hkd_self_status_header--clickable"
                        role="button"
                        tabindex="0"
                        t-att-aria-expanded="isExpanded ? 'true' : 'false'"
                        t-on-click.stop="() => this.toggleBatch(batch.ticket_id)"
                    >
                        <div class="hkd_self_status_title_wrap">
                            <span t-attf-class="hkd_self_icon_badge #{this.getPillClass(batch)}">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <path d="M12 2c1.5 2.5 4 4.5 4 8a4 4 0 1 1-8 0c0-1.6.6-3.1 1.5-4.3"/>
                                    <path d="M5 20h14"/>
                                </svg>
                            </span>
                            <div class="hkd_self_title_meta">
                                <span class="hkd_self_status_title" t-out="this.getBatchTitle(batch)"/>
                                <span t-if="batch.created_at" class="hkd_self_batch_time">
                                    <t t-out="this.formatBatchTime(batch.created_at)"/>
                                </span>
                            </div>
                        </div>
                        <div class="hkd_self_header_right">
                            <span t-attf-class="hkd_self_status_pill #{this.getPillClass(batch)}" t-out="batch.current_stage_name"/>
                            <span t-attf-class="hkd_self_chevron #{isExpanded ? 'hkd_self_chevron--open' : ''}" aria-hidden="true">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
                                    <polyline points="6 9 12 15 18 9"/>
                                </svg>
                            </span>
                        </div>
                    </div>
                    <t t-if="isExpanded">
                        <!-- Stepper Progress Track -->
                        <div class="hkd_self_stepper" t-if="batch.stages and batch.stages.length">
                            <t t-foreach="batch.stages" t-as="stage" t-key="stage.id">
                                <div t-attf-class="hkd_self_step #{this.getStepClasses(batch, stage, stage_index)}">
                                    <div class="hkd_self_step_track">
                                        <div t-attf-class="hkd_self_step_line #{stage_index === 0 ? 'hkd_self_step_line--hidden' : (this.isLeftLineFilled(batch, stage_index) ? 'hkd_self_step_line--filled' : '')}"/>
                                        <div class="hkd_self_step_dot">
                                            <t t-if="stage.state === 'done'">&#10003;</t>
                                            <t t-else="" t-out="stage_index + 1"/>
                                        </div>
                                        <div t-attf-class="hkd_self_step_line #{stage_index === batch.stages.length - 1 ? 'hkd_self_step_line--hidden' : (this.isRightLineFilled(batch, stage_index) ? 'hkd_self_step_line--filled' : '')}"/>
                                    </div>
                                    <div class="hkd_self_step_label" t-out="stage.name"/>
                                </div>
                            </t>
                        </div>
                        <!-- Individual Ordered Foods breakdown with preparation check -->
                        <div t-if="batch.categories and batch.categories.length" class="hkd_self_cat_groups">
                            <t t-foreach="batch.categories" t-as="cat" t-key="cat.category_id">
                                <div class="hkd_self_cat_group">
                                    <div class="hkd_self_cat_header">
                                        <span class="hkd_self_cat_badge" t-out="cat.category_name"/>
                                        <span class="hkd_self_cat_count">
                                            <t t-out="cat.total_qty"/> <t t-if="cat.total_qty === 1">item</t><t t-else="">items</t>
                                        </span>
                                    </div>
                                    <div class="hkd_self_cat_items">
                                        <t t-foreach="cat.lines" t-as="kl" t-key="kl.id">
                                            <div t-attf-class="hkd_self_cat_item #{kl.is_done ? 'hkd_self_cat_item--done' : ''}">
                                                <span class="hkd_self_cat_item_main">
                                                    <span class="hkd_self_cat_qty" t-out="`${kl.qty}x`"/>
                                                    <span class="hkd_self_cat_item_name" t-out="kl.name"/>
                                                </span>
                                                <span t-if="kl.note" class="hkd_self_cat_item_note text-muted small ms-2 fst-italic">
                                                    (<t t-out="kl.note"/>)
                                                </span>
                                                <span t-if="kl.is_done" class="hkd_self_cat_item_check">&#10003;</span>
                                            </div>
                                        </t>
                                    </div>
                                </div>
                            </t>
                        </div>
                    </t>
                </div>
            </t>
        </div>
    </t>

    <t t-name="hudson_kitchen_display.OrdersHistoryPage" t-inherit="pos_self_order.OrdersHistoryPage" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('o_so_order_header')]" position="after">
            <KitchenOrderStatusCard
                t-if="this.selfOrder.config?.self_ordering_mode === 'mobile' and this.isOrderActive(order)"
                orderAccessToken="order.access_token"
            />
        </xpath>
        <!-- Status badge follows the latest KDS stage of THIS order (Download Receipt stays) -->
        <xpath expr="//div[hasclass('o_so_order_header')]//span[hasclass('badge')]" position="attributes">
            <attribute name="t-att-class">this.getOrderBadgeClass(order)</attribute>
            <attribute name="t-out">this.getOrderStatusLabel(order)</attribute>
        </xpath>
    </t>

    <t t-name="hudson_kitchen_display.CartPage" t-inherit="pos_self_order.CartPage" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('cart_container')]/h1" position="after">
            <div t-if="this.showKitchenStatusBanner" class="mb-3">
                <div class="d-flex align-items-center justify-content-end mb-1">
                    <button type="button" class="btn btn-link btn-sm text-decoration-none fw-semibold px-1 py-0" t-on-click="this.openMyOrders">
                        View All My Orders &#8250;
                    </button>
                </div>
                <KitchenOrderStatusCard orderAccessToken="this.selfOrder.currentOrder.access_token"/>
            </div>
        </xpath>
    </t>

    <t t-name="hudson_kitchen_display.ConfirmationPage" t-inherit="pos_self_order.ConfirmationPage" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('o_pos_order_box')]" position="inside">
            <div t-if="this.showMobileKitchenStatus" class="mt-2 mb-2">
                <KitchenOrderStatusCard orderAccessToken="this.confirmedOrder.access_token"/>
            </div>
        </xpath>
        <xpath expr="//div[hasclass('o_pos_status_base')]/button" position="before">
            <button t-if="this.showMobileKitchenStatus" type="button" class="btn btn-lg btn-outline-primary w-100 mb-2" t-on-click="this.openMyOrders">
                Track Order in My Orders
            </button>
        </xpath>
    </t>

</templates>
