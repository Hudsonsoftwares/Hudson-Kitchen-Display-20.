<odoo>

    <record id="view_pos_prep_display_form" model="ir.ui.view">
        <field name="name">pos.prep.display.form</field>
        <field name="model">pos.prep.display</field>
        <field name="arch" type="xml">
            <form string="Preparation Display">
                <sheet>
                    <div class="oe_title mb24">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="Kitchen Display" required="1"/>
                        </h1>
                    </div>
                    <group>
                        <group name="pos_filtering" string="POS &amp; Categories">
                            <field name="company_id" groups="base.group_multi_company" options="{'no_create': True}"/>
                            <field name="pos_config_ids" widget="many2many_tags" placeholder="All" domain="[('company_id', '=', company_id)]"/>
                            <field name="category_ids" widget="many2many_tags" placeholder="All"/>
                        </group>
                        <group name="workflow_printing" string="Workflow &amp; Printing">
                            <field name="auto_clear"/>
                            <field name="auto_print"/>
                            <field name="print_stage_id" invisible="not auto_print"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Stages" name="stages">
                            <field name="stage_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="color" widget="color"/>
                                    <field name="alert_timer"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_pos_prep_display_list" model="ir.ui.view">
        <field name="name">pos.prep.display.list</field>
        <field name="model">pos.prep.display</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="pos_config_ids" widget="many2many_tags"/>
                <field name="stage_names"/>
                <field name="in_progress_count"/>
                <field name="average_time"/>
            </list>
        </field>
    </record>

    <record id="view_pos_prep_display_search" model="ir.ui.view">
        <field name="name">pos.prep.display.search</field>
        <field name="model">pos.prep.display</field>
        <field name="arch" type="xml">
            <search string="Preparation Displays">
                <field name="name"/>
                <field name="pos_config_ids"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <filter string="Company" name="group_by_company" domain="[]" context="{'group_by': 'company_id'}" groups="base.group_multi_company"/>
            </search>
        </field>
    </record>

    <record id="view_pos_prep_display_kanban" model="ir.ui.view">
        <field name="name">pos.prep.display.kanban</field>
        <field name="model">pos.prep.display</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_dashboard o_prep_display_kanban" create="1">
                <field name="id"/>
                <field name="name"/>
                <field name="company_id"/>
                <field name="stage_names"/>
                <field name="stage_names_list"/>
                <field name="in_progress_count"/>
                <field name="average_time"/>
                <templates>
                    <t t-name="menu">
                        <a name="action_configure" type="object" class="dropdown-item">Configure</a>
                        <a name="action_reset_all_orders" type="object" class="dropdown-item">Reset all orders</a>
                    </t>
                    <t t-name="card" class="o_prep_display_card p-3 d-flex flex-column justify-content-between position-relative">
                        <div class="w-100">
                            <div class="d-flex justify-content-between align-items-center mb-2 pe-4">
                                <h4 class="mb-0 fw-bold fs-5 text-truncate o_prep_card_title">
                                    <field name="name"/>
                                </h4>
                            </div>
                            <div class="d-flex flex-wrap gap-1 mb-4">
                                <t t-if="record.stage_names_list.raw_value and record.stage_names_list.raw_value.length">
                                    <t t-foreach="record.stage_names_list.raw_value" t-as="st_name" t-key="st_name_index">
                                        <span class="badge rounded-pill me-1 o_prep_stage_pill" t-out="st_name"/>
                                    </t>
                                </t>
                                <t t-elif="record.stage_names.value">
                                    <span class="badge rounded-pill me-1 o_prep_stage_pill">
                                        <field name="stage_names"/>
                                    </span>
                                </t>
                            </div>
                        </div>
                        <div class="d-flex justify-content-between align-items-end mt-auto pt-2 w-100">
                            <div class="d-flex gap-2">
                                <button name="action_open_kitchen_screen" type="object"
                                        class="btn btn-sm px-3 fw-bold shadow-none o_prep_btn_primary">
                                    Preparation Screen
                                </button>
                                <button name="action_open_order_status_screen" type="object"
                                        class="btn btn-sm px-3 fw-bold shadow-none o_prep_btn_secondary">
                                    Order Status Screen
                                </button>
                            </div>
                            <div class="ms-auto text-end o_prep_stats">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <span class="o_prep_stat_label">In progress</span>
                                    <span class="o_prep_stat_val fw-bold ms-3">
                                        <field name="in_progress_count"/>
                                    </span>
                                </div>
                                <div class="d-flex justify-content-between align-items-center">
                                    <span class="o_prep_stat_label">Average time</span>
                                    <span class="o_prep_stat_val fw-bold ms-3">
                                        <field name="average_time"/>'
                                    </span>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_pos_prep_display" model="ir.actions.act_window">
        <field name="name">Preparation Display</field>
        <field name="res_model">pos.prep.display</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No preparation display found. Let's create one!
            </p>
            <p>
                Preparation displays allow kitchen staff to see and process orders in real time.
            </p>
        </field>
    </record>

    <record id="action_pos_prep_display_config" model="ir.actions.act_window">
        <field name="name">Displays</field>
        <field name="res_model">pos.prep.display</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Configure displays and stages.
            </p>
        </field>
    </record>

</odoo>
