<odoo>

    <!-- ========================================================= -->
    <!-- Top-Level App: Kitchen Display (Apps Switcher / Sidebar)   -->
    <!-- ========================================================= -->
    <menuitem id="menu_kitchen_display_root"
              name="Kitchen Display"
              web_icon="hudson_kitchen_display,static/description/icon.png"
              sequence="51"/>

    <!-- 1. Preparation Display (First item, automatically opened when App icon is clicked) -->
    <menuitem id="menu_kitchen_display_main"
              name="Preparation Display"
              parent="menu_kitchen_display_root"
              action="action_pos_prep_display"
              sequence="10"/>

    <!-- 2. Orders / Order History -->
    <menuitem id="menu_kitchen_display_orders"
              name="Orders History"
              parent="menu_kitchen_display_root"
              action="action_pos_prep_order_history"
              sequence="20"/>

    <!-- 3. Reporting Menu (Kitchen Display) -->
    <menuitem id="menu_kitchen_display_reporting"
              name="Reporting"
              parent="menu_kitchen_display_root"
              groups="point_of_sale.group_pos_manager"
              sequence="25"/>

    <menuitem id="menu_kitchen_display_prep_time_report"
              name="Preparation Time Report"
              parent="menu_kitchen_display_reporting"
              action="action_pos_preparation_time_report"
              sequence="10"/>

    <!-- 4. Configuration Menu (for Managers) -->
    <menuitem id="menu_kitchen_display_config"
              name="Configuration"
              parent="menu_kitchen_display_root"
              groups="point_of_sale.group_pos_manager"
              sequence="30"/>

    <menuitem id="menu_kitchen_display_config_displays"
              name="Displays"
              parent="menu_kitchen_display_config"
              action="action_pos_prep_display_config"
              sequence="10"/>


    <!-- ========================================================= -->
    <!-- Also under Point of Sale                                  -->
    <!-- ========================================================= -->
    <menuitem id="menu_pos_prep_display_root"
              name="Preparation Display"
              parent="point_of_sale.menu_point_of_sale"
              action="action_pos_prep_display"
              sequence="25"/>

    <menuitem id="menu_pos_prep_order_history"
              name="Kitchen Order History"
              parent="point_of_sale.menu_point_of_sale"
              action="action_pos_prep_order_history"
              groups="point_of_sale.group_pos_manager"
              sequence="26"/>

    <menuitem id="menu_pos_preparation_time_report"
              name="Preparation Time Report"
              parent="point_of_sale.menu_point_rep"
              action="action_pos_preparation_time_report"
              groups="point_of_sale.group_pos_manager"
              sequence="25"/>

</odoo>
